# Copy this file to .env for local development.
# NEVER commit the real .env file (it is already in .gitignore).

# Your CricketData.org (CricAPI) API key. Get one at https://cricketdata.org/signup.aspx
CRICKET_API_KEY=your_api_key_here

# Comma-separated list of origins allowed to call this API (CORS).
# In production on Vercel, set this to your deployed frontend's exact origin,
# e.g. https://ipl-real-time-win-prediction.vercel.app
FRONTEND_ORIGIN=http://localhost:3000,http://127.0.0.1:5500
